rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. User Profiles & Subcollections ──────────────────
    match /users/{userId} {
      allow read, write: if true;

      // Inbox subcollection: personal to user
      match /inbox/{conversationId} {
        allow read, write: if true;
      }

      // FCM device tokens
      match /devices/{deviceId} {
        allow read, write: if true;
      }
    }

    match /profiles/{userId} {
      allow read, write: if true;
    }

    // ── 2. Bookings ─────────────────────────────────────────
    // Real-time access for both booking athletes and venue owners
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // ── 3. Turfs & Venues ──────────────────────────────────
    // Discoverable publicly; all owners and athletes sync venues in real-time
    match /turfs/{turfId} {
      allow read, write: if true;
    }

    match /venues/{venueId} {
      allow read, write: if true;
    }

    // ── 4. Marketplace Items ────────────────────────────────
    // Fully persistent listings across all accounts; survives refresh
    match /marketplace_items/{itemId} {
      allow read, write: if true;
    }

    // ── 5. Real-Time Chat & Direct Messaging ────────────────
    // Instant peer-to-peer message synchronization across accounts
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /typing/{userId} {
        allow read, write: if true;
      }

      match /presence/{userId} {
        allow read, write: if true;
      }

      match /members/{userId} {
        allow read, write: if true;
      }
    }

    // ── 6. Community Groups & Membership ────────────────────
    match /communityGroups/{groupId} {
      allow read, write: if true;

      match /members/{memberUid} {
        allow read, write: if true;
      }
    }

    // ── 7. Friendships & Follows ────────────────────────────
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }

    match /follows/{followId} {
      allow read, write: if true;
    }

    // ── 8. Stories & Posts ──────────────────────────────────
    match /stories/{storyId} {
      allow read, write: if true;
    }

    match /posts/{postId} {
      allow read, write: if true;
    }

    // ── 9. Tournaments ──────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }

    // Default Fallback: DENY all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
